---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StoryCard from "@/components/StoryCard.astro";

const entries = (await getCollection("towns", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-US", {
    dateStyle: "long",
    timeZone: "UTC",
  }).format(d);
---

<Layout
  title="Towns | Beautiful Iowa"
  description="The Iowa, On This Day town archive: every town week's stories, photographs, and records, kept permanently."
>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-border border-b pt-10 pb-8">
      <h1 class="font-display text-5xl font-semibold">The town archive</h1>
      <p class="mt-4 max-w-prose text-lg">
        Iowa, On This Day takes one Iowa town at a time and tells its story from
        the photographs, newspapers, and records the town left behind. The
        week's posts live here permanently, where they can be searched and kept,
        long after they have scrolled past on the Facebook Page.
      </p>
    </section>
    <ul class="grid grid-cols-1 gap-x-8 gap-y-12 pt-10 pb-4 sm:grid-cols-2">
      {
        entries.map(e => (
          <li>
            <StoryCard
              href={`/towns/${e.id}/`}
              title={e.data.title}
              description={e.data.description}
              kicker={`${e.data.town}, ${e.data.county}, in the week of ${fmt(e.data.pubDatetime)}`}
              heroImage={e.data.heroImage}
              heroImageWidth={e.data.heroImageWidth}
              heroImageHeight={e.data.heroImageHeight}
              heroCaption={e.data.heroCaption}
            />
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Layout>
