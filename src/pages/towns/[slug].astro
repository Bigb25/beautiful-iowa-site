---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContinueExploring from "@/components/ContinueExploring.astro";
import { relatedForTown } from "@/utils/related";

export async function getStaticPaths() {
  const entries = await getCollection("towns", ({ data }) => !data.draft);
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const videos = await getCollection("videos", ({ data }) => !data.draft);
const places = await getCollection("places", ({ data }) => !data.draft);
const fieldNotes = await getCollection(
  "field-notes",
  ({ data }) => !data.draft
);
const related = relatedForTown(entry, videos, places, fieldNotes);
const dateStr = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(d.pubDatetime);
---

<Layout title={`${d.title} | Beautiful Iowa`} description={d.description}>
  <Header />
  <main id="main-content" class="app-layout">
    <article class="pt-10 pb-4">
      <h1 class="font-display text-4xl leading-tight font-semibold sm:text-5xl">
        {d.title}
      </h1>
      <p class="text-muted-foreground mt-4">
        {d.town}, {d.county}, in the week of {dateStr}
      </p>
      {
        d.heroImage && (
          <figure class="mt-8">
            <img
              src={d.heroImage}
              alt={d.heroCaption ?? ""}
              width={d.heroImageWidth}
              height={d.heroImageHeight}
              class="w-full"
            />
            {d.heroCaption && (
              <figcaption class="text-muted-foreground mt-2 text-sm">
                {d.heroCaption}
              </figcaption>
            )}
          </figure>
        )
      }
      <div class="app-prose font-display mt-8 max-w-none">
        <Content />
      </div>
      {
        d.sourceNote && (
          <footer class="border-border text-muted-foreground mt-10 border-t pt-5 text-sm">
            <p>{d.sourceNote}</p>
          </footer>
        )
      }
      <ContinueExploring
        links={related}
        sectionHref="/towns/"
        sectionLabel="Read the town archive"
      />
    </article>
  </main>
  <Footer />
</Layout>
