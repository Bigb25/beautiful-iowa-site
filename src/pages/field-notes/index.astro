---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const entries = (
  await getCollection("field-notes", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());
const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-US", {
    dateStyle: "long",
    timeZone: "UTC",
  }).format(d);
---

<Layout
  title="Field Notes | Beautiful Iowa"
  description="A blog of the places we go: the parks, overlooks, courthouse squares, and quiet corners a drive through Iowa turns into."
>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-border border-b pt-10 pb-8">
      <h1 class="font-display text-5xl font-semibold">Field notes</h1>
      <p class="mt-4 max-w-prose text-lg">
        Most drives are just drives, until one of them turns into a stop: a
        state park gate left open, a marker everyone passes and nobody reads, a
        main street worth walking twice. When that happens, the stop becomes a
        note here, written up with the photographs we took standing there.
      </p>
    </section>
    <ul>
      {
        entries.map(e => (
          <li class="border-border border-b py-7">
            <p class="text-muted-foreground text-sm">
              {e.data.location}, on {fmt(e.data.pubDatetime)}
            </p>
            <h2 class="font-display mt-2 text-3xl font-semibold">
              <a class="hover:text-accent" href={`/field-notes/${e.id}/`}>
                {e.data.title}
              </a>
            </h2>
            <p class="mt-2 max-w-prose">{e.data.description}</p>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Layout>
