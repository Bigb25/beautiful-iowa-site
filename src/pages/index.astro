---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const byDateDesc = (
  a: { data: { pubDatetime: Date } },
  b: { data: { pubDatetime: Date } }
) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime();

const towns = (await getCollection("towns", ({ data }) => !data.draft)).sort(
  byDateDesc
);
const places = (await getCollection("places", ({ data }) => !data.draft)).sort(
  byDateDesc
);
const notes = (
  await getCollection("field-notes", ({ data }) => !data.draft)
).sort(byDateDesc);
const films = (await getCollection("videos", ({ data }) => !data.draft)).sort(
  byDateDesc
);

const currentTown = towns[0];
const latestPlace = places[0];

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-US", {
    dateStyle: "long",
    timeZone: "UTC",
  }).format(d);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section aria-label="Sunrise over the Mississippi River at Effigy Mounds">
      <figure class="relative left-1/2 w-screen max-w-none -translate-x-1/2">
        <div class="relative">
          <img
            src="/images/effigy-mounds-fire-point.jpg"
            alt="Sunrise over the Mississippi River seen from Fire Point at Effigy Mounds National Monument: golden light on the water, wooded bluffs, and the wide river valley below."
            width="1920"
            height="1266"
            fetchpriority="high"
            class="h-[62vh] w-full object-cover"
          />
          <div
            class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#1e3a2a]/85 via-[#1e3a2a]/35 to-transparent pt-24 pb-6"
          >
            <div class="app-layout">
              <h1
                class="font-display text-6xl font-semibold text-[#f7f1e3] sm:text-7xl"
              >
                Beautiful Iowa
              </h1>
              <p
                class="font-display mt-3 max-w-prose text-xl text-[#f7f1e3]/90 italic"
              >
                River bluffs and state parks, small-town main streets and back
                roads, and the stories they keep.
              </p>
            </div>
          </div>
        </div>
        <figcaption class="app-layout text-muted-foreground mt-3 text-sm">
          Sunrise over the Mississippi River from Fire Point, Effigy Mounds
          National Monument. Photograph by Eaton Coté, National Park Service,
          public domain.
        </figcaption>
      </figure>
    </section>

    <section class="border-border border-b py-10">
      <p class="max-w-prose text-lg">
        Welcome to Beautiful Iowa. This is Iowa the way Iowans see it: the
        overlooks and the waterfalls, the courthouses and the covered bridges,
        the quiet places and the famous ones. The films live on YouTube; this
        site is their permanent home, and the home of the town archive and the
        field notes, where everything can be searched and kept.
      </p>
    </section>
    {
      currentTown && (
        <section class="border-border border-b py-10">
          <h2 class="font-display text-3xl font-semibold">
            From the town archive
          </h2>
          <p class="text-muted-foreground mt-3 text-sm">
            {currentTown.data.town}, {currentTown.data.county}, in the week of{" "}
            {fmt(currentTown.data.pubDatetime)}
          </p>
          <h3 class="font-display mt-2 text-4xl leading-tight font-semibold">
            <a class="hover:text-accent" href={`/towns/${currentTown.id}/`}>
              {currentTown.data.title}
            </a>
          </h3>
          <p class="mt-3 max-w-prose">{currentTown.data.description}</p>
          <p class="mt-5">
            <a class="text-accent underline underline-offset-4" href="/towns/">
              Read the town archive
            </a>
          </p>
        </section>
      )
    }

    {
      latestPlace && (
        <section class="border-border border-b py-10">
          <h2 class="font-display text-3xl font-semibold">Places</h2>
          <p class="text-muted-foreground mt-3 text-sm">
            {latestPlace.data.place}, {latestPlace.data.county}
            {latestPlace.data.region ? ` — ${latestPlace.data.region}` : ""}
          </p>
          {latestPlace.data.heroImage && (
            <figure class="mt-4">
              <img
                src={latestPlace.data.heroImage}
                alt={latestPlace.data.heroCaption ?? ""}
                width={latestPlace.data.heroImageWidth}
                height={latestPlace.data.heroImageHeight}
                class="w-full"
              />
            </figure>
          )}
          <h3 class="font-display mt-4 text-4xl leading-tight font-semibold">
            <a class="hover:text-accent" href={`/places/${latestPlace.id}/`}>
              {latestPlace.data.title}
            </a>
          </h3>
          <p class="mt-3 max-w-prose">{latestPlace.data.description}</p>
          <p class="mt-5">
            <a class="text-accent underline underline-offset-4" href="/places/">
              See all the places
            </a>
          </p>
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section class="border-border border-b py-10">
          <h2 class="font-display text-3xl font-semibold">Field notes</h2>
          <ul>
            {notes.slice(0, 3).map(e => (
              <li class="border-border border-b py-6 last:border-b-0">
                <p class="text-muted-foreground text-sm">
                  {e.data.location}, on {fmt(e.data.pubDatetime)}
                </p>
                <h3 class="font-display mt-1 text-2xl font-semibold">
                  <a class="hover:text-accent" href={`/field-notes/${e.id}/`}>
                    {e.data.title}
                  </a>
                </h3>
                <p class="mt-1 max-w-prose">{e.data.description}</p>
              </li>
            ))}
          </ul>
          <p class="mt-2">
            <a
              class="text-accent underline underline-offset-4"
              href="/field-notes/"
            >
              Read all the field notes
            </a>
          </p>
        </section>
      )
    }

    {
      films.length > 0 && (
        <section class="py-10">
          <h2 class="font-display text-3xl font-semibold">The films</h2>
          <ul>
            {films.slice(0, 3).map(e => (
              <li class="border-border border-b py-6 last:border-b-0">
                <p class="text-muted-foreground text-sm">
                  {e.data.youtubeId ? (
                    <>
                      Published {fmt(e.data.pubDatetime)}
                      {e.data.duration ? `, runs ${e.data.duration}` : ""}
                    </>
                  ) : (
                    "Preview"
                  )}
                </p>
                <h3 class="font-display mt-1 text-2xl font-semibold">
                  <a class="hover:text-accent" href={`/videos/${e.id}/`}>
                    {e.data.title}
                  </a>
                </h3>
                <p class="mt-1 max-w-prose">{e.data.description}</p>
              </li>
            ))}
          </ul>
          <p class="mt-2">
            <a class="text-accent underline underline-offset-4" href="/videos/">
              See all the films
            </a>
          </p>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
